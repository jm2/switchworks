# Switchworks coordinator, as a system service under its own account.
#
# It runs as the unprivileged switchworks user, so agents running as you on
# this machine cannot read its CA key, admin token or fleet state in
# /var/lib/switchworks. The packages ship this unit disabled; set it up with
#
#   sudo swk service install --system coordinator
#   sudo swk --system coordinator init --host coord.lan,10.0.0.5
#   sudo swk service start --system coordinator
#
# (or `sudo systemctl enable --now swk-coordinator` once initialized).
[Unit]
Description=Switchworks coordinator (system service)
Documentation=https://github.com/jm2/switchworks
After=network-online.target
Wants=network-online.target
# Until `swk --system coordinator init` has run, boot skips it rather than
# failing (and retrying) every time.
ConditionPathExists=/var/lib/switchworks/coordinator/coordinator.json

[Service]
User=switchworks
Group=switchworks
Environment=SWK_HOME=/var/lib/switchworks
StateDirectory=switchworks
StateDirectoryMode=0700
WorkingDirectory=/var/lib/switchworks
ExecStart=@SWK@ coordinator run
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# The coordinator needs its own directory and the network, nothing else: it
# runs no agents and starts no programs.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
