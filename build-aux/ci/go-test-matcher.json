{
  "problemMatcher": [
    {
      "owner": "go-test-line",
      "severity": "error",
      "pattern": [{ "regexp": "^\\s+(\\S*_test\\.go):(\\d+): (?!coord: )(.+)$", "file": 1, "line": 2, "message": 3 }]
    },
    {
      "owner": "go-test-fail",
      "severity": "error",
      "pattern": [{ "regexp": "^((?:--- FAIL|panic|fatal error): .+)$", "message": 1 }]
    }
  ]
}
